# The only key you have to set. One key covers speech, transcription and reasoning.
OPENROUTER_API_KEY=

# Voice or terminal. Text mode needs nothing at all — no key, no browser, no audio.
VOICE_MODE=voice

# The language the voice speaks and the transcriber expects.
VOICE_LANG=English

# The only two lines the models do not write: what the call says when it heard nothing, and
# when the transcript and the brain named different options. They do NOT follow VOICE_LANG.
VOICE_RETRY_LINE=Sorry, I didn't catch that. Can you repeat?
VOICE_CONFIRM_LINE=I'm not sure which one you picked. Which is it?

# Which implementation fills each slot. Today there is one of each; a local engine would
# land here as a new name and nothing else would change.
VOICE_AUDIO=browser
VOICE_TTS=openrouter
VOICE_STT=openrouter
VOICE_BRAIN=openrouter

# The models. MAI-Voice-2-Flash has no Italian voice — Harper is multilingual and reads
# Italian with an English accent. Swap the model here if that grates.
VOICE_TTS_MODEL=microsoft/mai-voice-2-flash
VOICE_TTS_VOICE=en-US-Harper:MAI-Voice-2
VOICE_STT_MODEL=openai/whisper-large-v3-turbo
VOICE_BRAIN_MODEL=openai/gpt-oss-20b

# How OpenRouter picks which provider serves the brain. Measured on gpt-oss-20b: 0.3 s on the
# fastest, 3-6 s typical, once 20.6 s. Empty hands the choice back to the router.
VOICE_BRAIN_SORT=throughput

# How long the page keeps the button armed before giving up (ms), and how often it pulses a
# soft cue while it waits. The point is that you can be away from the desk.
VOICE_WAIT_MS=180000
VOICE_WAIT_TICK_MS=5000

# A runaway conversation is a runaway bill: after this many exchanges the call closes itself
# and Claude gets {kind:"end"}. It can always ask again. Asking for detail is a normal path,
# and "spiegami meglio / e la terza? / perché" costs three exchanges before any decision.
VOICE_MAX_TURNS=12

# Utterance capture. 800 ms cut a real sentence in half at an ordinary comma — a pause you
# take while thinking is longer than one you take between words. The two levels are RMS %:
# the first is what starts your turn, the second (lower on purpose) what keeps it going,
# because an unstressed syllable dips below the level that opened it.
VOICE_RECORD_SILENCE_MS=1300
VOICE_SPEECH_LEVEL=3
VOICE_HOLD_LEVEL=1.5

# 1 turns the Stop-hook nudge off, leaving the tool available but never asked for.
VOICE_DISABLE=0

# Pin the brain to named providers instead of sorting (comma-separated slugs). Measured:
# advertised TPS is the wrong number for a thirty-token answer — Amazon Bedrock at 295 TPS
# answered in 499 ms median, Groq at 160 TPS in 264 ms.
VOICE_BRAIN_PROVIDER=

# Ask the brain for a JSON object. Without it GPT-OSS returned an empty final channel 4 times
# in 10. Set to 0 only when pinning a provider that does not support it (Amazon Bedrock).
VOICE_BRAIN_JSON=1

# Run each call in a fresh process, so editing the code does not need Claude Code restarted.
# Costs a node startup and a tab reconnection per call. For development only.
VOICE_DEV=0

# Let your voice cut the reply short. Off by default: with the microphone open during
# playback, an imperfect echo canceller makes the voice interrupt itself mid-sentence.
VOICE_BARGE_IN=0

# --- The browser tab ---------------------------------------------------------------------
# The tab IS the sound card: microphone, speaker and echo cancellation all live in it.
#
# The bridge listens on loopback. That is still right when the browser is on another machine:
# `ssh -L 8787:127.0.0.1:8787 <user>@<host>` puts the tunnel inside this loopback. Setting
# VOICE_BROWSER_HOST=0.0.0.0 exposes the microphone bridge to the network — only do it if you
# know why you are doing it.
VOICE_BROWSER_HOST=127.0.0.1
VOICE_BROWSER_PORT=8787

# Whether to open a browser automatically. Left unset it is decided by the machine: a desktop
# opens the tab, a headless box prints the URL instead of waiting for one that never comes.
# 0 = never open, 1 = always try.
# VOICE_BROWSER_OPEN=
