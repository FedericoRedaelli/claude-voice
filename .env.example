# The only key you have to set. One key covers speech, transcription and reasoning.
OPENROUTER_API_KEY=

# Voice or terminal. Text mode needs nothing at all — no key, no browser, no audio.
VOICE_MODE=voice

# The language the voice speaks and the transcriber expects.
VOICE_LANG=Italiano

# Which implementation fills each slot. Today there is one of each; a local engine would
# land here as a new name and nothing else would change.
VOICE_AUDIO=browser
VOICE_TTS=openrouter
VOICE_STT=openrouter
VOICE_BRAIN=openrouter

# The models. MAI-Voice-2-Flash has no Italian voice — Harper is multilingual and reads
# Italian with an English accent. Swap the model here if that grates.
VOICE_TTS_MODEL=microsoft/mai-voice-2-flash
VOICE_TTS_VOICE=en-US-Harper:MAI-Voice-2
VOICE_STT_MODEL=openai/whisper-large-v3-turbo
VOICE_BRAIN_MODEL=openai/gpt-oss-20b

# How OpenRouter picks which provider serves the brain. Measured on gpt-oss-20b: 0.3 s on the
# fastest, 3-6 s typical, once 20.6 s. Empty hands the choice back to the router.
VOICE_BRAIN_SORT=throughput

# How long the page keeps the button armed before giving up (ms).
VOICE_WAIT_MS=30000

# Pin the brain to named providers instead of sorting (comma-separated slugs). Measured:
# advertised TPS is the wrong number for a thirty-token answer — Amazon Bedrock at 295 TPS
# answered in 499 ms median, Groq at 160 TPS in 264 ms.
VOICE_BRAIN_PROVIDER=

# Ask the brain for a JSON object. Without it GPT-OSS returned an empty final channel 4 times
# in 10. Set to 0 only when pinning a provider that does not support it (Amazon Bedrock).
VOICE_BRAIN_JSON=1
