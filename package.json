{
  "name": "claude-voice",
  "version": "0.9.0",
  "description": "A voice loop for Claude Code — Claude's stopping-point answer is spoken aloud and you reply by voice.",
  "type": "module",
  "license": "MIT",
  "author": "Federico Redaelli",
  "homepage": "https://github.com/FedericoRedaelli/claude-voice",
  "repository": { "type": "git", "url": "git+https://github.com/FedericoRedaelli/claude-voice.git" },
  "bin": { "claude-voice-mcp": "./bin/voice-mcp.mjs" },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "url": "node scripts/url.mjs",
    "check": "node scripts/setup.mjs --check",
    "server": "node bin/voice-mcp.mjs",
    "test": "node --test --test-timeout=15000 test/*.test.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:voice": "node scripts/smoke-voice.mjs",
    "try": "node scripts/try-call.mjs",
    "feedback": "node scripts/feedback.mjs",
    "sounds": "node scripts/make-attention.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  }
}
